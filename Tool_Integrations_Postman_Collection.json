{
  "info": {
    "name": "Tool Integrations - GRC Platform",
    "description": "APIs for HRMS (Zoho People), ITSM (Jira Service Management), evidence collection, and control evaluation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "tool-integrations"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8005"
    },
    {
      "key": "org_id",
      "value": "00000000-0000-0000-0000-000000000001"
    },
    {
      "key": "user_id",
      "value": "00000000-0000-0000-0000-000000000002"
    },
    {
      "key": "tool_id_zoho",
      "value": "00000000-0000-0000-0000-000000000003"
    },
    {
      "key": "tool_id_jira",
      "value": "00000000-0000-0000-0000-000000000004"
    },
    {
      "key": "integration_id",
      "value": "00000000-0000-0000-0000-000000000005"
    },
    {
      "key": "control_id",
      "value": "00000000-0000-0000-0000-000000000006"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Returns { \"status\": \"ok\" } if the service is up."
          }
        }
      ]
    },
    {
      "name": "HRMS - Zoho People",
      "item": [
        {
          "name": "Create Zoho integration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{org_id}}\",\n  \"user_id\": \"{{user_id}}\",\n  \"tool_id\": \"{{tool_id_zoho}}\",\n  \"configuration_data\": {\n    \"client_id\": \"YOUR_ZOHO_CLIENT_ID\",\n    \"client_secret\": \"YOUR_ZOHO_CLIENT_SECRET\",\n    \"redirect_uri\": \"https://your-app.com/hrms/zoho/callback\",\n    \"region\": \"com\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/hrms/zoho/integrations",
              "host": ["{{base_url}}"],
              "path": ["hrms", "zoho", "integrations"]
            },
            "description": "Creates or updates the Zoho People tool integration and returns an authorization URL. Redirect the user to authorization_url to complete OAuth. After login, Zoho redirects to redirect_uri with ?code=...&state=<integration_id>."
          }
        },
        {
          "name": "Zoho OAuth callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/hrms/zoho/callback?code=OAUTH_CODE_FROM_ZOHO&state=INTEGRATION_ID",
              "host": ["{{base_url}}"],
              "path": ["hrms", "zoho", "callback"],
              "query": [
                { "key": "code", "value": "OAUTH_CODE_FROM_ZOHO", "description": "Auth code from Zoho redirect" },
                { "key": "state", "value": "INTEGRATION_ID", "description": "integration_id returned by Create Zoho integration" }
              ]
            },
            "description": "Called when Zoho redirects back after user authorizes. Exchange code for tokens, fetch Employee Directory and Department Structure, sync Employees (including date_of_exit), create Evidence and EvidenceCollections, map to controls. Redirects to evidence listing URL."
          }
        }
      ]
    },
    {
      "name": "ITSM - Jira Service Management",
      "item": [
        {
          "name": "Create Jira integration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{org_id}}\",\n  \"user_id\": \"{{user_id}}\",\n  \"tool_id\": \"{{tool_id_jira}}\",\n  \"configuration_data\": {\n    \"client_id\": \"YOUR_ATLASSIAN_CLIENT_ID\",\n    \"client_secret\": \"YOUR_ATLASSIAN_CLIENT_SECRET\",\n    \"redirect_uri\": \"https://your-app.com/itsm/jira/callback\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/itsm/jira/integrations",
              "host": ["{{base_url}}"],
              "path": ["itsm", "jira", "integrations"]
            },
            "description": "Creates or updates the Jira Service Management integration and returns an authorization URL. User authorizes at Atlassian; redirect to redirect_uri with ?code=...&state=<integration_id>."
          }
        },
        {
          "name": "Jira OAuth callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/itsm/jira/callback?code=OAUTH_CODE&state=INTEGRATION_ID",
              "host": ["{{base_url}}"],
              "path": ["itsm", "jira", "callback"],
              "query": [
                { "key": "code", "value": "OAUTH_CODE", "description": "Auth code from Atlassian redirect" },
                { "key": "state", "value": "INTEGRATION_ID", "description": "integration_id from Create Jira integration" }
              ]
            },
            "description": "Exchanges code for tokens, gets cloud_id, fetches Service Desks and Customer Requests, classifies offboarding requests, creates Evidence (Service Desks, Customer Requests, Offboarding Requests), maps to controls. Redirects to evidence listing URL."
          }
        }
      ]
    },
    {
      "name": "Evidence collection",
      "item": [
        {
          "name": "Refresh and collect (one integration)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/integrations/{{integration_id}}/refresh-and-collect",
              "host": ["{{base_url}}"],
              "path": ["integrations", "{{integration_id}}", "refresh-and-collect"]
            },
            "description": "For the given integration_id: refresh access token if expired or expiring within 5 minutes, then run evidence collection (Zoho or Jira). Returns { status, integration_id, evidence_collected }."
          }
        },
        {
          "name": "Refresh and collect by org",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/integrations/refresh-and-collect-by-org?organization_id={{org_id}}",
              "host": ["{{base_url}}"],
              "path": ["integrations", "refresh-and-collect-by-org"],
              "query": [
                { "key": "organization_id", "value": "{{org_id}}", "description": "Organization UUID" }
              ]
            },
            "description": "Runs refresh-and-collect for all active integrations in the organization. Returns { status, organization_id, total, success, failed, first_error }."
          }
        }
      ]
    },
    {
      "name": "Control evaluation",
      "item": [
        {
          "name": "Offboarding ticket per leaver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization_id\": \"{{org_id}}\",\n  \"control_id\": \"{{control_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/evaluate/offboarding-ticket-per-leaver",
              "host": ["{{base_url}}"],
              "path": ["evaluate", "offboarding-ticket-per-leaver"]
            },
            "description": "Evaluates: every leaver (Employees with date_of_exit <= today) has at least one offboarding ticket in Jira (matched by requester_email). Persists result to ControlResults. Returns { control_result_id, organization_id, control_id, result, run_at, details }."
          }
        },
        {
          "name": "Access removed within 24h",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization_id\": \"{{org_id}}\",\n  \"control_id\": \"{{control_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/evaluate/access-removed-within-24h",
              "host": ["{{base_url}}"],
              "path": ["evaluate", "access-removed-within-24h"]
            },
            "description": "Stub evaluator: persists result PENDING_IDP until an Identity Provider (Okta, Entra ID, etc.) is integrated. Returns { control_result_id, organization_id, control_id, result: \"PENDING_IDP\", run_at, details }."
          }
        }
      ]
    }
  ]
}
